# Port for Express Server
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example local: mongodb://127.0.0.1:27017/festivo
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/festivo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/festivo

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development
